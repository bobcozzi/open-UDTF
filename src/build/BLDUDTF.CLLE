BLDUDTF:     PGM        PARM(&UDTF &EXTPGM &EXTPGMSRC &EXTPGMMBR +
                             &UDTFSRC &OBJLIB &DBGVIEW &DROP &SPECNAME)
                   dcl &udtf *char 10
                   dcl &extpgm *char 10
                   dcl &extpgmsrc *char 20
                   dcl &extpgmMbr *char 10
                   dcl &udtfsrc *char 20
                   dcl &objlib *char 10
                   dcl &dbgview *char 8
                   dcl &srctype *char 10
                   dcl &extpgmlib *char 10
                   dcl &drop      *lgl  1
                   dcl &specName  *char 128
                   dcl &inline *char 10 value('*ON')
                   dcl &OPTIMIZE *char 8 value('30')
                   dcl &sql *char 256
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ENDPGM))

             IF (&DBGVIEW *NE '*NONE') THEN(DO)
               CHGVAR     VAR(&INLINE) VALUE('*OFF')
               CHGVAR     VAR(&OPTIMIZE) VALUE('10')
             ENDDO

             IF (&EXTPGMMBR = '*EXTPGM') THEN(DO)
               CHGVAR     VAR(&EXTPGMMBR) VALUE(&EXTPGM)
             ENDDO

             RTVMBRD    FILE(%SST(&EXTPGMSRC 11 10)/%SST(&EXTPGMSRC +
                          01 10)) MBR(&EXTPGMMBR) +
                          RTNLIB(&EXTPGMLIB) SRCTYPE(&SRCTYPE)

             IF (&DROP = '1') THEN(DO)
               IF (&SPECNAME = '*UDTF') THEN(DO)
                 CHGVAR VAR(&SPECNAME) VALUE(&UDTF)
               ENDDO
             RUNSQL     SQL('DROP FUNCTION' *BCAT &OBJLIB *TCAT '.' +
                          *CAT &SPECNAME) COMMIT(*NONE) NAMING(*SYS)
             MONMSG     MSGID(CPF0000)
             ENDDO

             IF (&SRCTYPE = 'CPP') THEN(DO)
 CRTCPP:     CRTCPPMOD  MODULE(&OBJLIB/&EXTPGM) +
                          SRCFILE(&EXTPGMLIB/%SST(&EXTPGMSRC 1 10)) +
                          SRCMBR(&EXTPGMMBR) OUTPUT(*PRINT) +
                          OPTION(*RTTIALL *SHOWSRC) OPTIMIZE(&OPTIMIZE) +
                          INLINE(*ON) DBGVIEW(&DBGVIEW) +
                          DEFINE('__MULTI__' '_MULTI_THREADED') +
                          LANGLVL(*EXTENDED0X) SYSIFCOPT(*IFS64IO) +
                          MSGLMT(*NOMAX 20) REPLACE(*YES) +
                          TGTRLS(*CURRENT) TERASPACE(*YES *TSIFC) +
                          STGMDL(*INHERIT) DTAMDL(*P128) +
                          PACKSTRUCT(16) WEAKTMPL(*YES)
             ENDDO

             CRTPGM     PGM(&OBJLIB/&UDTF) ACTGRP(*CALLER) +
                          OPTION(*DUPPROC *DUPVAR) ALWLIBUPD(*YES) +
                          USRPRF(*USER) REPLACE(*YES) STGMDL(*INHERIT)
 CRTFUNC:
    RUNSQLSTM  SRCFILE(%SST(&UDTFSRC 11 10)/%SST(&UDTFSRC 01 10)) SRCMBR(&UDTF) +
                 COMMIT(*NONE) NAMING(*SYS) ERRLVL(30) +
                 DATFMT(*ISO) DFTRDBCOL(&OBJLIB) +
                 OPTION(*LIST) SECLVLTXT(*YES) +
                 OUTPUT(*PRINT) +
                 DBGVIEW(&DBGVIEW)

 ENDPGM:     ENDPGM
